; Eirdan Android Runtime prototype.
; Stable bootstrap only: gameplay migration has not started.

config_version=5

[application]
config/name="Eirdan Runtime"
run/main_scene="res://app/bootstrap.tscn"
config/features=PackedStringArray("4.7")
config/version="0.1.0-foundation"

[autoload]
Diagnostics="*res://diagnostics/diagnostics.gd"
PackageValidators="*res://packages/package_validators.gd"
Packages="*res://packages/package_manager.gd"
DataRegistry="*res://data/data_registry.gd"
SaveStore="*res://persistence/save_store.gd"
Modules="*res://modules/module_runtime.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
